# Database
DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/fallout_agent

# AWS SQS
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=your-key-id
AWS_SECRET_ACCESS_KEY=your-secret-key
SQS_QUEUE_URL=https://sqs.us-east-1.amazonaws.com/123456789/fallout-queue
SQS_POLL_INTERVAL_SECONDS=5
SQS_MAX_MESSAGES=10

# EHAP (Internal Claude Platform)
EHAP_BASE_URL=https://ehap.internal.example.com
EHAP_API_KEY=your-ehap-api-key
EHAP_MODEL=claude-sonnet-4-6
EHAP_TIMEOUT_SECONDS=60

# Subscriber API
SUBSCRIBER_API_BASE_URL=https://subscriber-api.internal.example.com
SUBSCRIBER_API_KEY=your-subscriber-api-key

# Agent Config
MAX_TOOL_CALLS_PER_RUN=20
DRY_RUN=false
CONFIDENCE_GATE_ENABLED=true

# Self-learning
UNMATCHED_FALLOUT_THRESHOLD=5
SKILL_EFFECTIVENESS_MIN_RATE=0.5

# Metrics (optional — leave blank to disable)
METRICS_SINK=cloudwatch
CLOUDWATCH_NAMESPACE=FalloutAgent
